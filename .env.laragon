# Server Configuration
HOST_PORT=80
SESSION_SECRET=change_me_to_your_generated_string
WEBROOT_PATH=C:\path\to\the\public-folder

# MySQL Database
MYSQL_HOST=localhost
MYSQL_DB=chores
MYSQL_USER=root
# Leave root password blank for Laragon
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Admin User & Password
ADMIN_1=admin
PASSWORD_HASH_1='your_bcrypt_hash'

# Parent User & Password (optional)
# ADMIN_2=parent
# PASSWORD_HASH_2='your_bcrypt_hash'

# Kid User & Password
KIDUSER=kid
KIDPASS_HASH='your_bcrypt_hash'

# Read-only User & Password (optional; can view but cannot edit or check boxes)
# READONLYUSER=viewer
# READONLYPASS_HASH='your_bcrypt_hash'

# Council Information (injected into rule pages at render time)
COUNCIL_NAME=Jane Doe
COUNCIL_PHONE=(555) 555-5555

# Paths to the folders (HOST paths - used for volume mounts in Docker, but also for writable checks)
LOGS_PATH=C:\path\to\the\logs-folder
DATA_PATH=C:\path\to\the\data-folder