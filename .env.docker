# Server Configuration
HOST_PORT=3001
SESSION_SECRET=change_me_to_your_generated_string
WEBROOT_PATH=/var/www/public
TIME_ZONE=America/New_York

# MySQL Database
MYSQL_HOST=db
MYSQL_DB=chores
MYSQL_USER=chores_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_to_a_different_strong_password

# Admin User & Password
ADMIN_1=admin
PASSWORD_HASH_1='your_bcrypt_hash'

# Parent User & Password (optional)
# ADMIN_2=parent
# PASSWORD_HASH_2='your_bcrypt_hash'

# Kid User & Password
KIDUSER=kid
KIDPASS_HASH='your_bcrypt_hash'

# Read-only User & Password (optional; can view but cannot edit or check boxes)
# READONLYUSER=viewer
# READONLYPASS_HASH='your_bcrypt_hash'

# Council Information (injected into rule pages at render time)
COUNCIL_NAME=Jane Doe
COUNCIL_PHONE=(555) 555-5555

# Paths to the folders you want to mount (HOST paths - used for volume mounts)
# The container paths are set in docker-compose.yml environment section
# PUBLIC_PATH=./public  # (Optional)
LOGS_PATH=./logs
DATA_PATH=./data